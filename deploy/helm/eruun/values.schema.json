{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "runtime",
    "serviceAccount"
  ],
  "properties": {
    "replicaCount": false,
    "resources": false,
    "service": {
      "type": "object",
      "properties": {
        "grpcPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heartbeatInterval",
        "leaseDuration",
        "leaseReaperInterval",
        "workerDrainTimeoutSeconds",
        "terminationGracePeriodSeconds",
        "leaderLockName",
        "replicas"
      ],
      "properties": {
        "heartbeatInterval": {
          "type": "string",
          "minLength": 1
        },
        "leaseDuration": {
          "type": "string",
          "minLength": 1
        },
        "leaseReaperInterval": {
          "type": "string",
          "minLength": 1
        },
        "workerDrainTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 2
        },
        "leaderLockName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "serviceAccount"
        ],
        "properties": {
          "serviceAccount": {
            "required": [
              "create"
            ],
            "properties": {
              "create": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "serviceAccount": {
            "properties": {
              "name": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
