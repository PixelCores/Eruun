    "ingressDomain": "apps.example.com",
    "ingressClass": "nginx",
    "ingressNamespace": "ingress-nginx",
    "dnsNamespace": "kube-system",
    "quota": {
      "pods": "20",
      "requests.cpu": "2",
      "limits.cpu": "4",
      "requests.memory": "4Gi",
      "limits.memory": "8Gi",
      "persistentvolumeclaims": "10",
      "requests.storage": "20Gi",
      "requests.nvidia.com/gpu": "0"
    }
  }
