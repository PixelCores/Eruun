{
  "type": "apiAuth",
  "value": {
    "enabled": true,
    "jwt": {
      "algorithms": ["HS256"],
      "clockSkewSeconds": 60,
      "hs256": {
        "_comment": "replace-with-a-strong-secret 是占位符，请替换为真实强密钥；不要使用读取接口返回的脱敏值 ******",
        "secret": "replace-with-a-strong-secret"
      }
    },
    "authorization": {
      "defaultEffect": "deny",
      "routes": [
        { "method": "GET", "path": "/api/v1/settings", "roles": ["admin"] },
        { "method": "GET", "path": "/api/v1/settings/:type", "roles": ["admin"] },
        { "method": "POST", "path": "/api/v1/settings", "roles": ["admin"] },
        { "method": "PUT", "path": "/api/v1/settings/:type", "roles": ["admin"] },
        { "method": "DELETE", "path": "/api/v1/settings/:type", "roles": ["admin"] },

        { "method": "GET", "path": "/api/v1/authz/routes", "roles": ["admin"] },
        { "method": "PUT", "path": "/api/v1/authz/routes", "roles": ["admin"] },
        { "method": "DELETE", "path": "/api/v1/authz/routes", "roles": ["admin"] },
        { "method": "PATCH", "path": "/api/v1/authz/default-effect", "roles": ["admin"] },

        { "method": "POST", "path": "/api/v1/applications", "roles": ["admin", "deployer"] },
        { "method": "GET", "path": "/api/v1/applications", "roles": ["admin", "reader"] }
      ]
    }
  }
}
