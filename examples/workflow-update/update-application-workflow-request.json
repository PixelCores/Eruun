{
  "name": "update-flow",
  "alias": "Update Flow",
  "workflowType": "update",
  "failurePolicy": "cleanup_all",
  "steps": [
    {
      "name": "manual-approval",
      "stepType": "approval",
      "mode": "StepByStep",
      "approval": {
        "notifyUrl": "https://example.com/workflow/approval",
        "message": "请确认是否继续发布",
        "method": "POST",
        "timeoutSeconds": 0
      }
    },
    {
      "name": "precheck",
      "mode": "StepByStep",
      "components": ["config"]
    },
    {
      "name": "migrate-data",
      "mode": "StepByStep",
      "components": ["mysql"]
    },
    {
      "name": "deploy-backend",
      "mode": "StepByStep",
      "components": ["backend"]
    }
  ]
}
