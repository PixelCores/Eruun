{
  "name": "share-ignore-demo",
  "alias": "share-ignore-demo",
  "namespace": "default",
  "version": "1.0.0",
  "project": "default",
  "description": "share strategy ignore demo",
  "workflow": [
    {
      "name": "share-ignore-step",
      "mode": "StepByStep",
      "components": [
        "cm-ignore"
      ]
    }
  ],
  "components": [
    {
      "name": "cm-ignore",
      "type": "config",
      "namespace": "default",
      "replicas": 1,
      "properties": {
        "conf": {
          "app.yaml": "mode: ignore\n"
        }
      },
      "traits": {
        "share": {
          "strategy": "ignore"
        }
      }
    }
  ]
}
