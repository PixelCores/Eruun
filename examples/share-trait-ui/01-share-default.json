{
  "name": "share-default-demo",
  "alias": "share-default-demo",
  "namespace": "default",
  "version": "1.0.0",
  "project": "default",
  "description": "share strategy default demo",
  "workflow": [
    {
      "name": "share-default-step",
      "mode": "StepByStep",
      "components": [
        "cm-default",
        "cm-no-share"
      ]
    }
  ],
  "components": [
    {
      "name": "cm-default",
      "type": "config",
      "namespace": "default",
      "replicas": 1,
      "properties": {
        "conf": {
          "app.yaml": "mode: default\n"
        }
      },
      "traits": {
        "share": {
          "strategy": "default"
        }
      }
    },
    {
      "name": "cm-no-share",
      "type": "config",
      "namespace": "default",
      "replicas": 1,
      "properties": {
        "conf": {
          "app.yaml": "mode: no-share\n"
        }
      }
    }
  ]
}
