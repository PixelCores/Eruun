{
  "name": "job-demo-cron",
  "namespace": "default",
  "version": "1.0.0",
  "project": "demo-project",
  "description": "Scheduled job (cron) demo",
  "component": [
    {
      "name": "cron-task",
      "type": "scheduledjob",
      "image": "busybox:1.36",
      "namespace": "default",
      "replicas": 1,
      "properties": {
        "schedule": "0 0 * * *",
        "command": ["/bin/sh", "-c", "date"]
      },
      "traits": {}
    }
  ],
  "workflow": [
    {
      "name": "create-cron-task",
      "mode": "StepByStep",
      "components": ["cron-task"]
    }
  ]
}
