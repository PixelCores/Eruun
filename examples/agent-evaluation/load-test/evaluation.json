{
  "name": "harbor-load",
  "type": "eval",
  "spec": {
    "datasetId": "<UPLOADED_DATASET_ID>",
    "agent": {"name": "oracle"},
    "options": {"attempts": 1, "concurrency": 1},
    "timeoutSeconds": 900
  },
  "traits": {
    "resources": {"cpu": "1", "memory": "2Gi", "cpuLimit": "2", "memoryLimit": "4Gi"}
  },
  "resultPolicy": {
    "retentionDays": 1,
    "targets": [{"type": "database", "mode": "full"}]
  }
}
