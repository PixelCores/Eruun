{
  "name": "harbor-load",
  "type": "job",
  "traits": {
    "eval": {
      "env": "ack",
      "agent": "oracle",
      "taskPackageId": "<UPLOADED_DATASET_ID>",
      "attempts": 1,
      "concurrency": 1,
      "timeoutSeconds": 900,
      "resultPolicy": {
        "retentionDays": 1,
        "targets": [
          {
            "type": "database",
            "mode": "full"
          }
        ]
      }
    },
    "resources": {
      "cpu": "1",
      "memory": "2Gi",
      "cpuLimit": "2",
      "memoryLimit": "4Gi"
    }
  }
}
