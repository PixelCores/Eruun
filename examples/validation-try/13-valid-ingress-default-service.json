{
  "name": "ingress-default-service",
  "namespace": "default",
  "version": "1.0.0",
  "component": [
    {
      "name": "backend",
      "type": "webservice",
      "image": "nginx:1.24",
      "namespace": "default",
      "properties": {
        "ports": [{"port": 8080}]
      },
      "traits": {
        "ingress": [
          {
            "name": "backend-ingress",
            "ingressClassName": "nginx",
            "routes": [
              {
                "path": "/api",
                "backend": {}
              }
            ]
          }
        ]
      }
    }
  ],
  "workflow": [
    {
      "name": "deploy-backend",
      "mode": "StepByStep",
      "components": ["backend"]
    }
  ]
}
