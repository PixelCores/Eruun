{
  "name": "demo-target-work-env",
  "namespace": "default",
  "workflow": [
    {
      "name": "deploy-backend",
      "components": [
        "backend"
      ]
    }
  ],
  "components": [
    {
      "name": "backend",
      "type": "webservice",
      "image": "nginx:1.27",
      "replicas": 1,
      "properties": {
        "ports": [
          {
            "port": 8080
          }
        ]
      },
      "traits": {
        "targetWorkEnv": {
          "app": "lab"
        }
      }
    }
  ]
}
